CXX_STD = CXX17

# NLopt comes from the CRAN package nloptr (LinkingTo) rather than a system install: its
# headers declare the same C API nloptr registers as R_GetCCallable routines (src/wisp_nlopt.h),
# so no -lnlopt/-L linking is needed at all, only its include path.
PKG_CPPFLAGS = $(shell $(R_HOME)/bin/Rscript -e "cat(StanHeaders:::CxxFlags(TRUE))") \
               -I$(shell $(R_HOME)/bin/Rscript -e "cat(system.file('include', package = 'nloptr'))")

PKG_LIBS = $(shell $(R_HOME)/bin/Rscript -e "cat(StanHeaders:::LdFlags(TRUE))")
