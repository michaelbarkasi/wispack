CXX_STD = CXX17

# NLopt comes from the CRAN package nloptr (LinkingTo) rather than a hardcoded local path:
# see src/Makevars for why (same reasoning, both platforms).
PKG_CPPFLAGS = $(shell "${R_HOME}/bin/Rscript.exe" -e "cat(StanHeaders:::CxxFlags(TRUE))") \
               -I$(shell "${R_HOME}/bin/Rscript.exe" -e "cat(system.file('include', package = 'nloptr'))")

PKG_LIBS = $(shell "${R_HOME}/bin/Rscript.exe" -e "cat(StanHeaders:::LdFlags(TRUE))")