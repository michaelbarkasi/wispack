importFrom(graphics, curve)
importFrom(methods, new)
importFrom(stats, coef, confint, cor, density, dgamma, ecdf, integrate, lm, na.omit, nls, qnorm, qqnorm,
           quantile, rbeta, relevel, residuals, rnorm, rpois, runif, sd, shapiro.test, step, var)
